# vc707_pins.xdc  (110_3 / 10_6) -- VC707 pins + the board clock.
#
# Same pins as v7.3 (test/constraints/vc707_pins.xdc, incl. the corrected
# UART pins of 2026-10-03). What changed: there is no Clocking Wizard any
# more -- clk_mem IS the board's 200 MHz clock (IBUFDS -> BUFG), so the
# clock has to be created here, and every clk_wiz_0 name is gone. The SM
# clocks are generated by the 12 MMCMs + 12 PLLs (rtl/sm_clk.v); Vivado derives
# them automatically from their attributes (400 MHz = DIV_MIN).
# constraints/clocks.tcl makes them asynchronous to each other and to
# clk_mem; constraints/pblocks.tcl places every SM.

set_property CFGBVS GND [current_design]
set_property CONFIG_VOLTAGE 1.8 [current_design]

# ---- 200 MHz differential system clock (SiT9102, LVDS) ----
set_property PACKAGE_PIN E19 [get_ports sysclk_200_p]
set_property PACKAGE_PIN E18 [get_ports sysclk_200_n]
set_property IOSTANDARD LVDS [get_ports sysclk_200_p]
set_property IOSTANDARD LVDS [get_ports sysclk_200_n]
create_clock -period 5.000 -name sysclk [get_ports sysclk_200_p]

# ---- CPU_RESET (SW8), active high ----
set_property PACKAGE_PIN AV40 [get_ports cpu_reset]
set_property IOSTANDARD LVCMOS18 [get_ports cpu_reset]

# ---- 8 DIP switches ----
set_property PACKAGE_PIN AV30 [get_ports {gpio_dip_sw[0]}]
set_property PACKAGE_PIN AY33 [get_ports {gpio_dip_sw[1]}]
set_property PACKAGE_PIN BA31 [get_ports {gpio_dip_sw[2]}]
set_property PACKAGE_PIN BA32 [get_ports {gpio_dip_sw[3]}]
set_property PACKAGE_PIN AW30 [get_ports {gpio_dip_sw[4]}]
set_property PACKAGE_PIN AY30 [get_ports {gpio_dip_sw[5]}]
set_property PACKAGE_PIN BA30 [get_ports {gpio_dip_sw[6]}]
set_property PACKAGE_PIN BB31 [get_ports {gpio_dip_sw[7]}]
set_property IOSTANDARD LVCMOS18 [get_ports {gpio_dip_sw[*]}]

# ---- 8 LEDs ----
set_property PACKAGE_PIN AM39 [get_ports {gpio_led[0]}]
set_property PACKAGE_PIN AN39 [get_ports {gpio_led[1]}]
set_property PACKAGE_PIN AR37 [get_ports {gpio_led[2]}]
set_property PACKAGE_PIN AT37 [get_ports {gpio_led[3]}]
set_property PACKAGE_PIN AR35 [get_ports {gpio_led[4]}]
set_property PACKAGE_PIN AP41 [get_ports {gpio_led[5]}]
set_property PACKAGE_PIN AP42 [get_ports {gpio_led[6]}]
set_property PACKAGE_PIN AU39 [get_ports {gpio_led[7]}]
set_property IOSTANDARD LVCMOS18 [get_ports {gpio_led[*]}]

# ---- USB-UART (CP2103) -- named from the FPGA's point of view ----
# usb_uart_rxd = data INTO the FPGA = AU33, usb_uart_txd = data OUT = AU36
# (fixed on 2026-10-03; the board net names are from the CP2103's side)
set_property PACKAGE_PIN AU33 [get_ports usb_uart_rxd]
set_property PACKAGE_PIN AU36 [get_ports usb_uart_txd]
set_property IOSTANDARD LVCMOS18 [get_ports usb_uart_rxd]
set_property IOSTANDARD LVCMOS18 [get_ports usb_uart_txd]

# ---- asynchronous board I/O: synchronized in the RTL, not timed ----
set_false_path -from [get_ports usb_uart_rxd]
set_false_path -from [get_ports cpu_reset]
set_false_path -from [get_ports {gpio_dip_sw[*]}]
set_false_path -to   [get_ports usb_uart_txd]
set_false_path -to   [get_ports {gpio_led[*]}]
